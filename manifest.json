{
  "manifestVersion": 2,
  "id": "hana-run-code",
  "name": "Hana Run Code",
  "version": "0.1.0",
  "description": "跑一段临时 Node 程序：可用 fs 与子进程，只把打印或返回的结果交回对话",
  "entry": "bin/app.mjs",
  "icon": "assets/icon.svg",
  "minAppVersion": "1.1.35-beta",
  "capabilities": [
    "app/tools.expose-to-model",
    "app/process.spawn"
  ]
}
